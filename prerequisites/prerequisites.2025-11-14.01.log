/******** QUERY *********/
CREATE DATABASE boring_sql
WITH
OWNER = boring_sql
TABLESPACE = boring_sql_data
ENCODING = UTF8
LOCALE = 'en_US.UTF-8'
IS_TEMPLATE = false
ALLOW_CONNECTIONS = true
TEMPLATE = template0
LOCALE_PROVIDER = libc
COLLATION_VERSION = '2.42'
LC_CTYPE = 'en_US.UTF-8'
LC_COLLATE = 'en_US.UTF-8'
CONNECTION LIMIT = -1
/************************/

